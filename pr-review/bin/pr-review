#!/usr/bin/env bash
set -euo pipefail
# Resolve this script's real path (it is symlinked into ~/bin).
source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  dir=$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd)
  source=$(readlink "$source")
  [[ $source != /* ]] && source="$dir/$source"
done
repo=$(cd -P "$(dirname "$source")/.." >/dev/null 2>&1 && pwd)
# uv may only be on PATH inside the repo (mise activate scopes tools per
# directory), so resolve it through mise against the repo's config when the
# bare name isn't found.
if command -v uv >/dev/null 2>&1; then
  exec uv run --project "$repo" pr-review "$@"
fi
exec mise x -C "$repo" -- uv run --project "$repo" pr-review "$@"
